VITE_API_BASE=http://localhost:3000

# Set this to the same value as backend EXTENSION_API_TOKEN when calling a deployed backend.
# The extension uses this token to attach per-request signed auth headers.
# VITE_EXTENSION_API_TOKEN=replace-with-a-long-random-string

# Optional: extension-side timeout for backend API calls in milliseconds.
# VITE_REQUEST_TIMEOUT_MS=20000
