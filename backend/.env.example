# ============================================
# SOURCECHECK BACKEND — Environment Variables
# ============================================
# Copy this file to .env.local and fill in your key.
# NEVER commit .env.local to git.

# Google Gemini API (AI Studio)
# Get your key: https://aistudio.google.com/app/apikey
# This is the ONLY API key you need.
# Gemini handles both LLM calls AND web search via grounding.
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the Gemini model.
# Current fast default in code: gemini-3.1-flash-lite-preview
# Gemini 2.5 Pro: gemini-2.5-pro
# Gemini 2.5 Flash: gemini-2.5-flash
# Gemini 2.5 Flash-Lite: gemini-2.5-flash-lite
# GEMINI_MODEL=gemini-2.5-pro

# Optional: for Gemini 2.5 models, cap the thinking budget so short JSON tasks
# do not spend the whole output budget "thinking".
# GEMINI_THINKING_BUDGET=128

# Optional: comma-separated Chrome extension IDs allowed to call a deployed backend.
# If unset, localhost/127.0.0.1 backends allow extension origins for local development only.
# ALLOWED_EXTENSION_IDS=abcdefghijklmnopqrstuvwxyzabcdef

# Required for deployed backends. The backend issues per-browser-session tokens
# signed with this secret. It is never shipped to the client.
# Generate with: openssl rand -hex 32
# SESSION_SECRET=replace-with-a-long-random-string

# Optional: session token lifetime in hours (default 168 = 7 days).
# SESSION_TTL_HOURS=168

# Optional: request timeout for Gemini API calls in milliseconds.
# GEMINI_REQUEST_TIMEOUT_MS=20000

# Optional: API gateway protections.
# Max inbound request body size in bytes.
# MAX_REQUEST_BYTES=120000
# Fixed-window rate limit settings (applied per route + caller identity).
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_POINTS=80

# Optional: Redis URL for durable, multi-instance-safe rate limiting.
# If unset, rate limits are process-local and reset on restart.
# Required for multi-instance production deployments.
# Format: redis://[:password@]host[:port][/db-number]
# REDIS_URL=redis://localhost:6379

# Supabase (add these when you set up auth later)
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
