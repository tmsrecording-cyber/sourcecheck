# Backend environment variables

# Required: Google Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_key_here

# Optional: Model selection
# Default: gemini-2.5-flash (FREEMIUM_MODEL constant)
# Allowed models: gemini-2.5-flash, gemini-3.1-flash-lite-preview, gemini-3-flash-preview
GEMINI_MODEL=gemini-2.5-flash

# Optional: External fact-check lookup
# Google Fact Check Tools / ClaimReview integration for public-claim reuse
FACT_CHECK_TOOLS_API_KEY=
FACT_CHECK_TOOLS_TIMEOUT_MS=3500

# Optional: Short-lived verify-claim cache for repeated public claims
VERIFY_CLAIM_CACHE_TTL_MS=60000

# Required for deployed backends
SESSION_SECRET=openssl_rand_hex_32
ALLOWED_EXTENSION_IDS=ext_id_1,ext_id_2

# Optional: Rate limiting (choose one approach)

# Option 1: Upstash Redis (recommended for serverless/Vercel)
# Uses REST API for stateless rate limiting across serverless instances
UPSTASH_REDIS_REST_URL=https://your-domain.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# Option 2: Redis with ioredis (traditional Redis connection)
# Keep for backward compatibility with existing Redis deployments
REDIS_URL=redis://host:port

# Rate limit configuration (applies to both Redis backends)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_POINTS=80

# Required when behind a reverse proxy (e.g., nginx, Vercel, Cloudflare)
# Number of trusted proxy hops between the client and your server.
# Used to extract the real client IP from X-Forwarded-For header.
# Set to 0 (default) if requests come directly from clients.
# 
# Common values:
# - 0: Direct client connections (local dev)
# - 1: Vercel (recommended for production deployments)
# - 2+: Multiple proxy layers (nginx + CDN)
TRUSTED_PROXY_COUNT=0
